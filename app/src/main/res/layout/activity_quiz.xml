<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000">

    <ImageView
        android:id="@+id/imgQuizBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="15dp"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/btnVoltar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Voltar"
            android:fontFamily="@font/comic"
            android:background="@drawable/bg_btn_arredondado"
            android:textColor="#FFF" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/txtPontuacao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pontos: 0"
            android:fontFamily="@font/comic"
            android:textColor="#FFD700"
            android:textSize="22sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:layout_gravity="center_vertical" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/timerArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="15dp"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <TextView
            android:id="@+id/txtTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="10"
            android:fontFamily="@font/comic"
            android:textColor="#FFF"
            android:textSize="48sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progressTimer"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="15dp"
            android:progress="100"
            android:progressTint="#FF3B30" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutAjudas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="5dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/timerArea">

        <ImageView android:id="@+id/btnAjuda5050" android:layout_width="50dp" android:layout_height="50dp" android:layout_marginEnd="15dp" android:src="@drawable/ajuda_5050" />
        <ImageView android:id="@+id/btnAjudaFreeze" android:layout_width="50dp" android:layout_height="50dp" android:layout_marginEnd="15dp" android:src="@drawable/ajuda_freeze" />
        <ImageView android:id="@+id/btnAjudaSkip" android:layout_width="50dp" android:layout_height="50dp" android:src="@drawable/ajuda_skip" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtPergunta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:gravity="center"
        android:text="..."
        android:fontFamily="@font/comic"
        android:textColor="#FFF"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/layoutAjudas"
        app:layout_constraintBottom_toTopOf="@id/layoutOpcoes" />

    <LinearLayout
        android:id="@+id/layoutOpcoes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button android:id="@+id/opt0" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:fontFamily="@font/comic" android:background="@drawable/bg_btn_arredondado" android:textAllCaps="false" />
        <Button android:id="@+id/opt1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:fontFamily="@font/comic" android:background="@drawable/bg_btn_arredondado" android:textAllCaps="false" />
        <Button android:id="@+id/opt2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:fontFamily="@font/comic" android:background="@drawable/bg_btn_arredondado" android:textAllCaps="false" />
        <Button android:id="@+id/opt3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:fontFamily="@font/comic" android:background="@drawable/bg_btn_arredondado" android:textAllCaps="false" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/overlayInterludio"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000"
        android:visibility="gone"
        android:elevation="8dp">
        <ImageView
            android:id="@+id/imgInterludio"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/overlayFimJogo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6000000"
        android:visibility="gone"
        android:elevation="10dp">
        <ImageView
            android:id="@+id/imgFimJogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>